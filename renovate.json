{
  "extends": ["github>ttt3pu/renovate-settings"],
  "packageRules": [
    {
      "description": "Automerge Tailwind CSS / PostCSS minor/patch when tests pass",
      "matchPackageNames": ["tailwindcss", "@tailwindcss/postcss", "postcss"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Automerge markdown-it minor/patch when tests pass",
      "matchPackageNames": ["markdown-it"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Automerge react / react-dom minor/patch when tests pass",
      "matchPackageNames": ["react", "react-dom"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Automerge next / @next/eslint-plugin-next minor/patch when tests pass",
      "matchPackageNames": ["next", "@next/eslint-plugin-next"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Automerge prisma / pg minor/patch when tests pass",
      "matchPackageNames": ["prisma", "@prisma/client", "@prisma/adapter-pg", "pg"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Automerge pnpm minor/patch when CI passes",
      "matchPackageNames": ["pnpm"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
