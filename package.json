{
  "type": "module",
  "name": "achievements-next",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24"
  },
  "packageManager": "pnpm@12.15.0",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev --hostname achievements-next.lvh.me",
    "build": "next build",
    "start": "next start",
    "lint:js": "eslint .",
    "lint:ts": "tsc --noEmit",
    "lint:style": "stylelint \"**/*.css\" --ignore-path .gitignore",
    "prettier": "prettier --check --ignore-path .gitignore --ignore-path .prettierignore .",
    "prettier:fix": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore .",
    "check": "pnpm lint:js && pnpm lint:ts && pnpm prettier && pnpm lint:style && pnpm test",
    "test": "vitest run",
    "test:update": "vitest run --update",
    "test:watch": "vitest",
    "postinstall": "pnpm prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "date-fns": "4.4.0",
    "next": "16.4.2",
    "next-auth": "4.24.15",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-datepicker": "9.1.0",
    "react-dom": "19.3.1",
    "react-toastify": "11.1.0",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@faker-js/faker": "10.6.0",
    "@next/eslint-plugin-next": "16.4.2",
    "@prisma/client": "7.10.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "markdown-it": "15.0.3",
    "postcss": "8.5.26",
    "prettier": "3.9.10",
    "react-icons": "5.7.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
